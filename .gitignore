src-tauri/target/

# Sidecar-Binary (Build-Artefakt/lokaler Dev-Wrapper, siehe
# src-tauri/binaries/README.md) - nicht versionieren.
src-tauri/binaries/papertrail-engine-*

# Python: Byte-compiled / Build-Artefakte
__pycache__/
*.py[codz]
*.so
build/
dist/
*.egg-info/
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec
!packaging/papertrail-engine.spec

# PyInstaller-Sidecar-Build (siehe packaging/build_sidecar.py) - reine
# Build-Artefakte, reproduzierbar aus packaging/papertrail-engine.spec.
packaging/.build/
packaging/.dist/
packaging/.pyinstaller-build/

# Test / Coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage.xml

# Python Environments
.env
.envrc
.venv
env/
venv/

# mypy / ruff
.mypy_cache/
.ruff_cache/

