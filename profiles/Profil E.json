{
  "version": "1.0",                
  "case_sensitive": true,         
  "normalize_whitespace": false,
  "compare_mode": "words",
  "text_extraction": "native",
  "report_format": "pdf",
  "ocr": {
        "enabled": false,
        "confidence_threshold": 0.85,
        "dpi": 200,
        "mode_reference": "fallback",
        "mode_candidate": "fallback"
  },
  "exclude_regions": [
        { "page": 1,  "x": 0,  "y": 0,  "width": 64,  "height": 840  }
                     ]
}