{
  "version": "1.0",
  "case_sensitive": false,
  "normalize_whitespace": true,
  "exclude_regions": [
    {
      "page": 1,
      "x": 0,
      "y": 770,
      "width": 200,
      "height": 55
    }
  ],
  "page_groups": [
    {
      "pattern": "Rechnung Nr\\..*",
      "name": "Rechnung"
    }
  ],
  "report_format": "pdf",
  "ocr": {
    "enabled": false,
    "confidence_threshold": 0.85
  }
}